# Copy to .env and adjust. Never commit real keys. Synthetic data only.
ENV=dev
LOG_LEVEL=INFO
# true → Plaid + LLM use offline mocks
DEMO_MODE=true

DATABASE_URL=sqlite:///./data/transition_studio.db
# DATABASE_URL=postgresql+psycopg://ts:ts@localhost:5432/transition_studio

JWT_SECRET=change-me-demo-only
JWT_EXPIRE_MINUTES=720

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

SYNTHETIC_SEED=20240501
AS_OF_DATE=2026-10-30

# random | aladdin (aladdin is a stub)
ANALYTICS_PROVIDER=random

# mock | anthropic
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

MAX_UPLOAD_MB=10
